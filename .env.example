# ============================================================
# Render GPU Gateway — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# On Render, set these in the Dashboard → Environment tab.
# ============================================================

# --- Primary Kaggle Account ---
KAGGLE_USERNAME=your_primary_kaggle_username
KAGGLE_KEY=your_primary_kaggle_api_token
KAGGLE_KERNEL_SLUG=gpu-inference-server

# --- Fallback Kaggle Account (Optional 60h Quota Pool) ---
KAGGLE2_USERNAME=your_fallback_kaggle_username
KAGGLE2_KEY=your_fallback_kaggle_api_token
KAGGLE2_KERNEL_SLUG=gpu-inference-server

# --- Groq API Fallback (Zero Cold-Start Inference) ---
# Optional: provides instant Whisper Large-v3 (~200ms) and Llama 3.1 8B inference
# while Kaggle GPU boots up (2-3 min delay) or if quotas are exhausted.
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.1-8b-instant

# --- Security ---
# Shared secret between Render and the notebook (pick any strong string)
SHARED_SECRET=change-me-to-a-random-string

# --- Auto-set by Render (do NOT set manually) ---
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
PORT=3000
